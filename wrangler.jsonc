{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tirakplus",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "MUSE_AGENT_CONFIG",
      "id": "5c914cc2d3094278bfe2b6516739a9c7"
    },
    {
      // Pre-auth Muse conversation adoption store. Keys:
      //   user:{userId}:conv:{conversationId} → MuseTranscriptSnapshot JSON
      // Local dev: any 32-hex ID works (wrangler --local stores under .wrangler/state).
      // Production: replace with output of `wrangler kv namespace create MUSE_CONVERSATIONS`.
      "binding": "MUSE_CONVERSATIONS",
      "id": "a1b2c3d4e5f60718293a4b5c6d7e8f00"
    }
  ],
  "services": [
    {
      "binding": "MUSE_RAG",
      "service": "tirakplus-muse-rag"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "PAYMENT_PROVIDER_MODE": "compliance_hold",
    "MUSE_AGENT_MODE": "external",
    "MUSE_AGENT_CONFIG_KEY": "muse:agent-config"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
