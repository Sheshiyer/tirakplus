{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tirakplus",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-05-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"kv_namespaces": [
		{
			"binding": "MUSE_AGENT_CONFIG",
			"id": "5c914cc2d3094278bfe2b6516739a9c7"
		},
		{
			// Pre-auth Muse conversation adoption store. Keys:
			//   user:{userId}:conv:{conversationId} → MuseTranscriptSnapshot JSON
			// Created 2026-05-26 in the tirak.court@gmail.com CF account
			// (acct 2c0c96c68f0ee73b6d980054557bca5b).
			"binding": "MUSE_CONVERSATIONS",
			"id": "442973720cba46129bc0118f96b0f4eb"
		},
		{
			// One-time-password store for email login. Keys:
			//   otp:{lowercase-email} → JSON { code, issuedAt, attempts }
			// 600s TTL set per-PUT. Deleted on successful verify.
			"binding": "AUTH_OTPS",
			"id": "2c16677830fb424aadd690f3e87106c6"
		},
		{
			// Account-scoped persistence for Pass E (privacy, data exports,
			// soft-delete schedule, safety-report summaries). Keys:
			//   account:{lowercase-email}:privacy        → AccountPrivacySettings
			//   account:{lowercase-email}:data-export    → AccountDataExportRequest
			//   account:{lowercase-email}:deletion       → AccountDeletionRecord
			//   account:{lowercase-email}:safety-reports → AccountSafetyReportSummary[]
			//
			// Created 2026-05-29 via `wrangler kv namespace create ACCOUNT_DATA`.
			"binding": "ACCOUNT_DATA",
			"id": "9fd53eb8f5504149b2a2c7e81d557f36"
		},
		{
			// Booking-flow persistence for Pass H (inquiry → accept → plan →
			// pay → day-of → review lifecycle). Keys:
			//   booking:{inquiryId}                              → BookingRecord (full state)
			//   booking:traveller:{lowercase-email}:inquiries    → string[] (inquiry IDs, newest first, capped 50)
			//   booking:companion:{lowercase-email}:inquiries    → string[] (inquiry IDs, newest first, capped 50)
			//   booking:companion:{lowercase-email}:rating-sum   → number (running sum, populated H6)
			//   booking:companion:{lowercase-email}:rating-count → number (running count, populated H6)
			//   booking:companion:{lowercase-email}:reviews      → ReviewSummary[] (capped 25, newest first, populated H6)
			//
			// Created 2026-05-29 via `wrangler kv namespace create BOOKING_DATA`.
			"binding": "BOOKING_DATA",
			"id": "5485b5dfe99144b48948735cbe4d26cf"
		}
	],
	"services": [
		{
			"binding": "MUSE_RAG",
			"service": "tirakplus-muse-rag"
		}
	],
	// NOTE: Cloudflare Email Sending binding (send_email) removed 2026-05-26.
	// It requires Workers Paid ($5/mo) AND a zone-level Dashboard
	// activation, neither of which we have today. Until both land, the
	// OTP path is Resend-only (env.RESEND_API_KEY → api.resend.com).
	// Re-add this block alongside Resend if/when we upgrade — sendOtpEmail
	// will pick CF first automatically (provider priority chain).
	//
	// "send_email": [{ "name": "EMAIL" }],
	"vars": {
		"ENVIRONMENT": "staging",
		"PAYMENT_PROVIDER_MODE": "compliance_hold",
		"MUSE_AGENT_MODE": "external",
		"MUSE_AGENT_CONFIG_KEY": "muse:agent-config",
		// Resend transactional sender. tirak.app is already verified on
		// Resend (status: verified, sending: enabled, region: ap-northeast-1
		// — set up 2025-09-23). Using this verified sender unlocks delivery
		// to ANY recipient; the previous onboarding@resend.dev shared
		// sender was free-tier-restricted to the account owner.
		"RESEND_FROM": "Muse · Tirak Plus <muse@tirak.app>"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}