{
  "name": "tirakplus",
  "version": "0.1.0",
  "description": "Muse-led private Thailand discovery web app for reviewed traveller and companion flows.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf:types": "wrangler types",
    "check": "npm run cf:types && tsc --noEmit && npm run build",
    "contract:smoke": "node scripts/contract-smoke.mjs",
    "copy:audit": "node scripts/copy-audit.mjs",
    "route:audit": "node scripts/route-audit.mjs",
    "quality:release": "npm run check && npm run copy:audit && npm run route:audit",
    "dev": "npm run build && wrangler dev --local --port 8787 --inspector-port 9237",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.15.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wrangler": "^4.58.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
