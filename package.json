{
  "name": "tirakplus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf:types": "wrangler types",
    "check": "npm run cf:types && tsc --noEmit && npm run build",
    "dev": "npm run build && wrangler dev --local --port 8787 --inspector-port 9237",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wrangler": "^4.58.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
